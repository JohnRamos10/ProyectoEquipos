@model ProyectoEquiposs.LoginViewModel
@{
    var role = ViewBag.Role as string;
    ViewData["Title"] = role != null ? $"Iniciar Sesión - {role}" : "Iniciar Sesión";
}

<h2>
    @if (!string.IsNullOrEmpty(role))
    {
        @:Iniciar Sesión como @role
    }
    else
    {
        @:Iniciar Sesión
    }
</h2>

<form method="post" asp-route-role="@(role ?? "")">
    <div class="form-group">
        <label asp-for="Correo"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="Clave"></label>
        <input asp-for="Clave" type="password" class="form-control" />
        <span asp-validation-for="Clave" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Entrar</button>

    @if (ViewBag.Error != null)
    {
        <div class="alert alert-danger mt-3">@ViewBag.Error</div>
    }
</form>
@if (string.Equals(role, "Cliente", System.StringComparison.OrdinalIgnoreCase))
{
    <p class="mt-3">
        ¿No tienes una cuenta?
        <a class="btn btn-link" asp-action="Register" asp-controller="Login">Regístrate aquí</a>
    </p>
}


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

